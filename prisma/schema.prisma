generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  PROVIDER
  ADMIN
}

enum UserStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PropertyStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum EscrowStatus {
  INITIATED
  FUNDED
  INSPECTION_PASSED
  COMPLETED
  DISPUTED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(BUYER)
  status        UserStatus @default(PENDING_ONBOARDING)
  fullName      String?
  phone         String?
  country       String    @default("NG")
  profilePhoto  String?
  bvn           String?
  nin           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  properties    Property[]
  comments      Comment[]
  escrowsAsBuyer Escrow[] @relation("BuyerEscrows")
  reviewsGiven  Review[]
  adminActions  AdminAction[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id              String         @id @default(cuid())
  ownerId         String
  title           String
  description     String         @db.Text
  price           Decimal        @db.Decimal(12, 2)
  currency        String         @default("NGN")
  country         String
  state           String
  city            String
  address         String
  propertyType    String
  bedrooms        Int?
  bathrooms       Int?
  status          PropertyStatus @default(PENDING_REVIEW)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  owner           User           @relation(fields: [ownerId], references: [id])
  images          PropertyImage[]
  documents       PropertyDocument[]
  comments        Comment[]
  escrows         Escrow[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  name       String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  content    String   @db.Text
  parentId   String?
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
}

model Escrow {
  id              String       @id @default(cuid())
  propertyId      String
  buyerId         String
  amount          Decimal      @db.Decimal(12, 2)
  status          EscrowStatus @default(INITIATED)
  monnifyRef      String?      @unique
  qrTokenHash     String?
  qrConsumed      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  property        Property     @relation(fields: [propertyId], references: [id])
  buyer           User         @relation("BuyerEscrows", fields: [buyerId], references: [id])
  ledgerEntries   LedgerEntry[]
}

model LedgerEntry {
  id          String   @id @default(cuid())
  escrowId    String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  createdAt   DateTime @default(now())
  escrow      Escrow   @relation(fields: [escrowId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  escrowId   String   @unique
  reviewerId String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  reviewer   User     @relation(fields: [reviewerId], references: [id])
}

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String
  targetId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  admin       User     @relation(fields: [adminId], references: [id])
}

model SecurityAuditLog {
  id          String   @id @default(cuid())
  userId      String?
  eventType   String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}